<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plain net8.0 test project. It compiles the pure data-logic files directly (no WinForms, no System.Management),
    so the tests run on Windows, Linux and CI alike with: dotnet test
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1416;CS8632</NoWarn>
    <RootNamespace>CNSysInfo.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.1.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\SysInfo.Wpf\ActivationLogic.cs" Link="Linked\ActivationLogic.cs" />
    <Compile Include="..\SysInfo.Wpf\UiStatusLogic.cs" Link="Linked\UiStatusLogic.cs" />
    <Compile Include="..\SysInfo.Wpf\CollectionSession.cs" Link="Linked\CollectionSession.cs" />
    <Compile Include="..\SysInfo.Wpf\UpdateLogic.cs" Link="Linked\UpdateLogic.cs" />
    <Compile Include="..\SysInfo.Wpf\CpuId.cs" Link="Linked\CpuId.cs" />
    <Compile Include="..\SysInfo.Wpf\CpuSupportEvaluator.cs" Link="Linked\CpuSupportEvaluator.cs" />
    <Compile Include="..\SysInfo.Wpf\WindowsVersionInfo.cs" Link="Linked\WindowsVersionInfo.cs" />
    <Compile Include="..\SysInfo.Wpf\WmiValueParser.cs" Link="Linked\WmiValueParser.cs" />
    <Compile Include="..\SysInfo.Wpf\DiagnosticLogic.cs" Link="Linked\DiagnosticLogic.cs" />
    <Compile Include="..\SysInfo.Wpf\LivePowerState.cs" Link="Linked\LivePowerState.cs" />
    <Compile Include="..\SysInfo.Wpf\BatteryMapper.cs" Link="Linked\BatteryMapper.cs" />
    <Compile Include="..\SysInfo.Wpf\StorageHealthLogic.cs" Link="Linked\StorageHealthLogic.cs" />
    <Compile Include="..\SysInfo.Wpf\NvmeHealthLogic.cs" Link="Linked\NvmeHealthLogic.cs" />
    <Compile Include="..\SysInfo.Wpf\SpecRating.cs" Link="Linked\SpecRating.cs" />
    <Compile Include="..\SysInfo.Wpf\ShutdownPlan.cs" Link="Linked\ShutdownPlan.cs" />
    <Compile Include="..\SysInfo.Wpf\Presentation.cs" Link="Linked\Presentation.cs" />
    <Compile Include="..\SysInfo.Wpf\ReportBuilder.cs" Link="Linked\ReportBuilder.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
